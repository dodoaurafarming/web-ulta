# URL WebSocket Bridge (lokal default ws_bridge.py port 8765; produksi VPS: wss://ws.domain-anda.com)
VITE_WS_URL=ws://127.0.0.1:8765

# URL REST API backend (Express + Prisma + TiDB Cloud)
# Lokal: http://localhost:4000/api | Produksi Vercel: https://web-ulta-api.vercel.app/api
# Kosongkan jika belum deploy API agar otomatis fallback ke leaderboard lokal (localStorage)
VITE_API_URL=http://localhost:4000/api

# Aktifkan Mock Mode (true/false) untuk pengujian UI saat server VPS/lokal mati
VITE_ENABLE_MOCK_MODE=false
