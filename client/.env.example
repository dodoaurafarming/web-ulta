# URL WebSocket Bridge VPS (contoh produksi: wss://ws.domain-anda.com)
VITE_WS_URL=ws://localhost:8080

# URL REST API backend (Express + Prisma + TiDB Cloud)
VITE_API_URL=http://localhost:4000/api

# Aktifkan Mock Mode (true/false) untuk pengujian UI saat server VPS mati
VITE_ENABLE_MOCK_MODE=false
