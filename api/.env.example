# Port server REST API Express
PORT=4000

# Origin frontend yang diizinkan (pisahkan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:5173

# Koneksi MySQL / TiDB Cloud Serverless (wajib SSL di TiDB Cloud)
# Contoh TiDB Cloud:
# DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/web_ulta?sslaccept=strict"
DATABASE_URL="mysql://root:password@localhost:3306/web_ulta"
