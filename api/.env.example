# Port server REST API Express (saat dijalankan lokal / VPS)
PORT=4000

# Origin frontend yang diizinkan (pisahkan koma jika lebih dari satu; mendukung wildcard seperti https://*.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://web-ulta.vercel.app

# Koneksi MySQL / TiDB Cloud Serverless (wajib SSL ?sslaccept=strict di TiDB Cloud)
# Contoh TiDB Cloud:
# DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/web_ulta?sslaccept=strict"
DATABASE_URL="mysql://root:password@localhost:3306/web_ulta"
